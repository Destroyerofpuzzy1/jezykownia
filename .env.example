# Public URL of the site (used for canonical URL, sitemap and structured data).
NEXT_PUBLIC_SITE_URL=

# Where "Dobierz zajęcia" leads are forwarded (server-side only).
# Any endpoint accepting JSON POST: Make / Zapier webhook, Google Apps Script
# (Google Sheets), or your own mail endpoint. Leave empty to keep the form in
# demo mode (nothing is sent and the visitor is told to call instead).
LEAD_WEBHOOK_URL=

